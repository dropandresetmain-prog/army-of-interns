# Convex (written by `npx convex dev`)
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=

# Twilio WhatsApp (set on the Convex deployment via `npx convex env set`)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_TEST_TO=whatsapp:+15551234567

# Optional local-only copies for scripts (never commit real values)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# TWILIO_TEST_TO=

# Telegram (Convex env). Live hackathon transport pivoted to Telegram
# because the current Twilio Sandbox setup is not usable.
# TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=army_of_intern_demo_bot

# Optional LLM extraction via OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# Demo admin gate (Convex env + local scripts). Landlord Reset also needs the
# public copy so the browser can call resetDemo.
# DEMO_ADMIN_SECRET=
# NEXT_PUBLIC_DEMO_ADMIN_SECRET=
